rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email_verified' in request.auth.token &&
         'email' in request.auth.token &&
         request.auth.token.email_verified == true &&
         request.auth.token.email == 'vishaldhandhala@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- ENTITY VALIDATION HELPERS ---
    function isValidPlayerProfile(data) {
      return data.userId is string &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.playerName is string &&
             data.playerName.size() >= 2 && data.playerName.size() <= 60 &&
             data.mobileNumber is string &&
             data.mobileNumber.matches('^[0-9]{10}$') &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 120)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidBooking(data) {
      return data.userId is string &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.passCode is string &&
             data.passCode.size() >= 4 && data.passCode.size() <= 24 &&
             data.passCode.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.playerName is string &&
             data.playerName.size() >= 2 && data.playerName.size() <= 60 &&
             data.playerMobile is string &&
             data.playerMobile.matches('^[0-9]{10}$') &&
             data.boxType in ['CRICKET', 'VOLLEYBALL'] &&
             data.date is string &&
             data.date.size() == 10 &&
             data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.startHour is int && data.startHour >= 0 && data.startHour <= 23 &&
             data.durationHours is int && data.durationHours >= 1 && data.durationHours <= 3 &&
             data.timeLabel is string && data.timeLabel.size() >= 3 && data.timeLabel.size() <= 40 &&
             data.tierLabel is string && data.tierLabel.size() >= 3 && data.tierLabel.size() <= 40 &&
             data.totalAmount is int && data.totalAmount >= 500 && data.totalAmount <= 5000 &&
             data.advanceAmount is int && data.advanceAmount >= 250 && data.advanceAmount <= 2500 &&
             data.balanceAmount is int && data.balanceAmount >= 250 && data.balanceAmount <= 2500 &&
             data.advanceAmount * 2 == data.totalAmount &&
             data.advanceAmount + data.balanceAmount == data.totalAmount &&
             data.utrNumber is string &&
             data.utrNumber.size() >= 8 && data.utrNumber.size() <= 30 &&
             data.utrNumber.matches('^[a-zA-Z0-9\\-]+$') &&
             (!('screenshotBase64' in data) || data.screenshotBase64 == null || (data.screenshotBase64 is string && data.screenshotBase64.size() <= 150000)) &&
             data.status in ['PENDING_VERIFICATION', 'VERIFIED', 'REJECTED', 'CANCELLED'] &&
             (!('adminNote' in data) || data.adminNote == null || (data.adminNote is string && data.adminNote.size() <= 200)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSlotLock(data) {
      return data.userId is string &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.bookingId is string && isValidId(data.bookingId) &&
             data.boxType in ['CRICKET', 'VOLLEYBALL'] &&
             data.date is string &&
             data.date.size() == 10 &&
             data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.hour is int && data.hour >= 0 && data.hour <= 23 &&
             data.status in ['PENDING_VERIFICATION', 'VERIFIED'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- COLLECTIONS ---

    match /admins/{adminUid} {
      allow get: if isSignedIn() && request.auth.uid == adminUid;
      allow list, write: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'playerName', 'mobileNumber', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'playerName', 'mobileNumber', 'email', 'createdAt', 'updatedAt']) &&
                       isValidPlayerProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidPlayerProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['playerName', 'mobileNumber', 'email', 'updatedAt']);

      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(bookingId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'PENDING_VERIFICATION' &&
                       incoming().keys().hasAll([
                         'userId', 'passCode', 'playerName', 'playerMobile',
                         'boxType', 'date', 'startHour', 'durationHours',
                         'timeLabel', 'tierLabel', 'totalAmount', 'advanceAmount',
                         'balanceAmount', 'utrNumber', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'passCode', 'playerName', 'playerMobile',
                         'boxType', 'date', 'startHour', 'durationHours',
                         'timeLabel', 'tierLabel', 'totalAmount', 'advanceAmount',
                         'balanceAmount', 'utrNumber', 'screenshotBase64',
                         'status', 'adminNote', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidBooking(incoming());

      allow update: if isSignedIn() &&
                       isValidId(bookingId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidBooking(incoming()) && (
                         // Tier 1: Admin can verify or reject bookings and add adminNote
                         (
                           isAdmin() &&
                           existing().status != 'CANCELLED' &&
                           incoming().status in ['VERIFIED', 'REJECTED', 'PENDING_VERIFICATION'] &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt'])
                         ) ||
                         // Tier 2: Owner can cancel only while still PENDING_VERIFICATION
                         (
                           existing().userId == request.auth.uid &&
                           existing().status == 'PENDING_VERIFICATION' &&
                           incoming().status == 'CANCELLED' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                         )
                       );

      allow delete: if false;
    }

    match /slot_locks/{lockId} {
      // Non-PII public schedule locks: any signed-in player can query active locks by status
      allow get: if isSignedIn() && isValidId(lockId) && existing().status in ['PENDING_VERIFICATION', 'VERIFIED'];
      allow list: if isSignedIn() && existing().status in ['PENDING_VERIFICATION', 'VERIFIED'];

      allow create: if isSignedIn() &&
                       isValidId(lockId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'PENDING_VERIFICATION' &&
                       incoming().keys().hasAll(['userId', 'bookingId', 'boxType', 'date', 'hour', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'bookingId', 'boxType', 'date', 'hour', 'status', 'createdAt', 'updatedAt']) &&
                       isValidSlotLock(incoming()) &&
                       lockId == (incoming().date + '_' + incoming().boxType + '_' + string(incoming().hour)) &&
                       existsAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)) &&
                       getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.userId == request.auth.uid;

      allow update: if isSignedIn() &&
                       isValidId(lockId) &&
                       isAdmin() &&
                       incoming().userId == existing().userId &&
                       incoming().bookingId == existing().bookingId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidSlotLock(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       isValidId(lockId) && (
                         isAdmin() ||
                         (existing().userId == request.auth.uid && existing().status == 'PENDING_VERIFICATION')
                       );
    }
  }
}
